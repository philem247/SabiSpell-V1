{
  "expo": {
    "name": "SabiSpell",
    "slug": "sabispell",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sabispell",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "SabiSpell",
      "shortName": "SabiSpell",
      "description": "Adaptive spelling league for Nigerian SSS 1-3 students",
      "themeColor": "#0A6EBD",
      "backgroundColor": "#0A6EBD",
      "display": "standalone",
      "orientation": "portrait",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141F25",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9cad41fb-ff60-43ad-88b4-93c2d2c66bbf"
      }
    }
  }
}
